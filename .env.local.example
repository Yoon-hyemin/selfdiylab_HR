DATABASE_URL=postgresql://user:password@ep-example-12345.us-east-2.aws.neon.tech/neondb?sslmode=require

# 계정 세션 쿠키(hr_auth) 서명용 비밀키. 아무 임의의 긴 문자열이면 됨
# (openssl rand -hex 32 등으로 생성). 미설정 시 로그인 자체가 실패한다.
SESSION_SECRET=choose-a-random-string

# HR_PASSWORD는 2026-08-11 개인 계정 로그인 도입으로 더 이상 쓰이지 않는다
# (과거: 구성원/채용 화면을 잠그던 공용 비밀번호). 남아있어도 무해하지만
# 새로 설정할 필요는 없다.

# scripts/bootstrap-admin.js를 실행할 때만 필요한 일회성 값 -- 앱 실행
# 자체에는 필요 없다. 최초 관리자 계정을 만든 뒤에는 이 값들을 지워도 된다
# (이미 계정이 있으면 스크립트가 아무것도 하지 않으므로 남겨둬도 안전하다).
# INITIAL_ADMIN_EMAIL=min02@selfdiylab.com
# INITIAL_ADMIN_TEMP_PASSWORD=choose-a-temp-password-with-a-letter-and-a-digit
