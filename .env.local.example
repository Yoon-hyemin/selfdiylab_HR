DATABASE_URL=postgresql://user:password@ep-example-12345.us-east-2.aws.neon.tech/neondb?sslmode=require

# Shared password gating the 인사 area (구성원 / 채용 / 인사 대시보드) and the
# endpoints behind it. 성과관리 data stays company-wide public and needs no
# password. If this is unset the gated endpoints fail closed (always 401), so
# it must be configured in the Vercel project's environment variables too.
HR_PASSWORD=choose-a-shared-password
